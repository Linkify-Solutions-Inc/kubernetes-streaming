# Non-secret configuration, cluster-internal values only.
# Overlays add or override keys with a `behavior: merge` configMapGenerator.
#
# Everything in here ends up as an explicit `configMapKeyRef` in a container's
# `env:` list. Nothing uses bare `envFrom` -- see docs/aws/11-workloads.md for
# why that distinction is load-bearing.

KAFKA_BOOTSTRAP_SERVERS=streaming-kafka-bootstrap.kafka.svc.cluster.local:9092
UPLOAD_API_URL=http://upload-api.streaming.svc.cluster.local:8000

# The transcode workload pulls from the ClusterIP Service, never from the
# public RTMP hostname. Pointing this at rtmp.k8s.linkifysolutions.com sends
# the traffic out to the NLB and back, where preserve_client_ip makes the
# hairpin fail -- see docs/aws/12-ingress-and-rtmp.md.
MEDIAMTX_RTMP_URL=rtmp://mediamtx.streaming.svc.cluster.local:1935

S3_BUCKET=media
S3_ADDRESSING_STYLE=path

MAX_UPLOAD_BYTES=2147483648
UPLOAD_RATE_LIMIT_COUNT=10
UPLOAD_RATE_LIMIT_WINDOW_MINUTES=60

# Read by ingest-webhook's /hooks/auth admission check, which lands in
# Module 14 together with the KEDA ScaledJobs. Present now so the value is
# already in git and reviewed when the code that reads it arrives.
MAX_CONCURRENT_LIVE_STREAMS=8
