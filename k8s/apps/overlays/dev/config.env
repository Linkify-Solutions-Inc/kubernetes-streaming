# Bare-metal box. Merged over base/config.env.

S3_BUCKET=media
S3_ADDRESSING_STYLE=path

# MinIO serves the bucket as a path segment, so the public base URL keeps
# the /media the CloudFront one drops.
HLS_PUBLIC_BASE_URL=http://aayush-internserver.hs.aayushpathak.com:9000/media
RTMP_PUBLIC_URL=rtmp://aayush-internserver.hs.aayushpathak.com:1935

MAX_UPLOAD_BYTES=2147483648
