# EKS-only configuration. Merged over base/config.env.
#
# Note what is NOT here: no S3_ENDPOINT, no S3_ACCESS_KEY, no S3_SECRET_KEY.
# On AWS, boto3 resolves the endpoint from the region and the credentials
# from the Pod Identity agent. Setting a static key here would win over the
# credential chain and silently disable the IAM role you configured in
# Module 7.

S3_BUCKET=linkify-streaming-media-242626138899

# Virtual-hosted addressing is AWS's supported direction, and path-style
# breaks TLS hostname matching for bucket names containing dots.
S3_ADDRESSING_STYLE=virtual

# Pod Identity injects this, but an add-on upgrade can silently drop it and
# boto3's failure is NoRegionError thrown at client construction inside a
# request handler -- a 500 with a stack trace nobody expects. Set it.
AWS_REGION=us-east-1

# No-DNS build. HLS plays back straight from S3 (bucket policy allows public
# reads on hls/* only; raw/ uploads stay private). No CloudFront, no DNS.
HLS_PUBLIC_BASE_URL=https://linkify-streaming-media-242626138899.s3.us-east-1.amazonaws.com/hls
# RTMP via the mediamtx NLB hostname (REBUILD-SENSITIVE: rediscover after the
# NLB provisions with:
#   kubectl get svc mediamtx-rtmp -n streaming \
#     -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')
RTMP_PUBLIC_URL=rtmp://k8s-streamin-mediamtx-6921c7d33a-a52534440e9cad03.elb.us-east-1.amazonaws.com:1935

# 2 GiB, not the code default of 5 GiB. See the upload-path section of
# docs/aws/12-ingress-and-rtmp.md for why 5 GiB does not survive the trip
# through web and upload-api on a t3.medium.
MAX_UPLOAD_BYTES=2147483648
